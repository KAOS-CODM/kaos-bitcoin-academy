# Development defaults. Copy to server/.env and fill in real values.
# Never commit server/.env. It is ignored by .gitignore.

NODE_ENV=development
PORT=4000

# Required. Use the existing MongoDB Atlas cluster (Free tier).
# Format: mongodb+srv://<username>:<password>@<cluster-host>/<optional-db>
MONGODB_URI=

# Database name inside the cluster.
MONGODB_DB=kaos_academy

# Required in production (and recommended locally). Generate a value with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional. The origin the browser uses. Same-origin requests are always allowed.
APP_ORIGIN=http://localhost:5173

LOG_LEVEL=info

# AI Tutor. Disabled unless AI_ENABLED=true AND OPENROUTER_API_KEY is set.
# The model is fixed server-side to OpenRouter's "openrouter/auto" routing alias.
AI_ENABLED=false
OPENROUTER_API_KEY=
