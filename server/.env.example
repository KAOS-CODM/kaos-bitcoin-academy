# KAOS Bitcoin Academy — server environment
#
# Copy this file to `server/.env` and fill in the real values.
# `server/.env` is ignored by Git and must never be committed.
#
# The server validates this configuration on start-up and refuses to start in production
# when a required value is missing. A failed validation prints only the field names, never
# the values, so a secret can never reach a log.

NODE_ENV=development
PORT=4000

# Required. The MongoDB Atlas cluster (Free tier is enough for the academy).
# Format: mongodb+srv://<username>:<password>@<cluster-host>/<optional-db>
MONGODB_URI=

# Database name inside the cluster.
MONGODB_DB=kaos_academy

# Required in production, and recommended locally. At least 32 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Optional. The origin the browser uses, for example https://academy.example.
# Same-origin requests are always accepted; this only adds an extra allowed origin.
APP_ORIGIN=http://localhost:5173

# Optional. A second allowed origin. Use it when the platform assigns a public URL that
# differs from the custom domain, for example a preview deployment URL.
RENDER_EXTERNAL_URL=

# Log level for the structured request log.
LOG_LEVEL=info

# AI Tutor. The tutor stays disabled unless AI_ENABLED=true AND OPENROUTER_API_KEY is set.
# The model is fixed server-side to OpenRouter's "openrouter/auto" routing alias, so no
# model catalogue or rotation is maintained by the academy.
AI_ENABLED=false
OPENROUTER_API_KEY=
