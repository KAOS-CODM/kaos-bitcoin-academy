{
  "name": "KAOS Bitcoin Academy",
  "short_name": "KAOS Academy",
  "description": "Free, beginner-first Bitcoin education. Learn how Bitcoin works, at your own pace.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "portrait-primary",
  "background_color": "#17140f",
